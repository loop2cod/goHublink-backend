# Railway: Set this in your service variables to reference the Postgres service
# DATABASE_URL=${{ Postgres.DATABASE_URL }}

# Alternative: Set individual variables (Railway will auto-populate RAILWAY_PRIVATE_DOMAIN)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gohublink
DB_SSLMODE=disable
RAILWAY_PRIVATE_DOMAIN=railway.internal

# WhatsApp Business API Configuration
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_APP_SECRET=your_app_secret_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token