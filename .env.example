# Railway: Set this in your service variables to reference the Postgres service
# DATABASE_URL=${{ Postgres.DATABASE_URL }}

# Alternative: Set individual variables (Railway will auto-populate RAILWAY_PRIVATE_DOMAIN)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gohublink
DB_SSLMODE=disable
RAILWAY_PRIVATE_DOMAIN=railway.internal